{
  "name": "travelmanager-3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:v2": "node scripts/av2-preview.mjs",
    "lint:v2": "node scripts/check-av2.mjs",
    "build:v2": "node scripts/check-av2.mjs --build",
    "test:v2": "node --test tests/av2-domain.test.mjs tests/av2-schema.test.mjs tests/av2-security.test.mjs tests/av2-finance.test.mjs tests/av2-provider.test.mjs tests/av2-ux.test.mjs tests/av2-locations.test.mjs tests/av2-event-detail.test.mjs tests/av2-root-transfer.test.mjs tests/av2-pin-auth.test.mjs tests/av2-pin-sheet.test.mjs tests/av2-map-docs.test.mjs",
    "test:v2:integration": "playwright test --config playwright.av2.config.mjs",
    "test:v2:remote": "node scripts/av2-remote-tests.mjs",
    "test:v2:remote:browser": "playwright test --config playwright.av2.remote.config.mjs",
    "build": "node scripts/bundle-supabase.mjs && node scripts/validate-build.mjs",
    "admin:set-pin": "node scripts/admin-set-pin.mjs",
    "start": "npx http-server ./public -c-1 -p 5003",
    "mock:server": "node tests/mock-server/server.mjs",
    "test:e2e": "playwright test --grep-invert \"authenticated Supabase sandbox\"",
    "test:supabase": "playwright test tests/supabase-adapter.spec.js",
    "test:auth": "node --test tests/auth-boot-contract.test.mjs",
    "test:supabase:live": "playwright test tests/supabase-live.spec.js",
    "test:italy:live": "playwright test tests/italy-live-ui.spec.js",
    "test:smoke": "playwright test tests/agenda-viajera.spec.js --grep \"logged out|inicia|navega\"",
    "test:v2:pin:docker": "node scripts/av2-pin-docker.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.0",
    "esbuild": "^0.28.2"
  }
}
